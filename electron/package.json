{
  "name": "voynich-workbench-desktop",
  "version": "3.2.0",
  "description": "Voynich Decipherment Workbench \u2014 desktop shell",
  "author": "Montgomery Kuykendall",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kuykendall.voynichworkbench",
    "productName": "Voynich Workbench",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "backend",
        "filter": [
          "VoynichWorkbench*"
        ]
      },
      {
        "from": "../LICENSE.md",
        "to": "LICENSE.md"
      },
      {
        "from": "../DATA-NOTICES.md",
        "to": "DATA-NOTICES.md"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
